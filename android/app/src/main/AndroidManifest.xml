<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ストレージ権限は不要: ファイルは SAF (ACTION_OPEN_DOCUMENT) 経由でのみ開く。
         USB Host は Phase 3 で uses-feature と UsbManager 権限ダイアログとして追加する。 -->
    <!-- USB ホスト機能は必須にしない (非対応端末でも SAF でイメージを開ける) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 他アプリへ NTFS を読み取り専用で公開する SAF プロバイダ (システムの Documents UI だけが呼べる) -->
        <provider
            android:name=".NtfsDocumentsProvider"
            android:authorities="org.usbmem.app.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
