<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ストレージ権限は不要: ファイルは SAF (ACTION_OPEN_DOCUMENT) 経由でのみ開く。
         USB Host は Phase 3 で uses-feature と UsbManager 権限ダイアログとして追加する。 -->
    <!-- USB ホスト機能は必須にしない (非対応端末でも SAF でイメージを開ける) -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- パスワードの記憶 (Keystore + BiometricPrompt): BiometricManager.canAuthenticate が要る。無いと SecurityException で「記憶する」が一切出ない (2026-11-19 に AVD で発見)。 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:name=".UsbApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.UsbStorage">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|uiMode|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 他アプリへ NTFS を読み取り専用で公開する SAF プロバイダ (システムの Documents UI だけが呼べる) -->
        <provider
            android:name=".NtfsDocumentsProvider"
            android:authorities="org.usbmem.app.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
        <!-- 個人版の FUSE 層 (wimfuse): 別プロセス (:wimfuse) で libwimfuse.so (wimlib の wimmount) を exec・監督するサービス。アプリの外へは公開しない。docs/fuse-layer.md 10 章 -->
        <service
            android:name=".wimfuse.WimFuseService"
            android:process=":wimfuse"
            android:exported="false" />
    </application>
</manifest>
