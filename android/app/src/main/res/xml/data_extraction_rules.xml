<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 以降のバックアップ・端末間の移行の規則 (docs/privacy-and-permissions.md)。
     アプリのデータ (SMB の接続設定・Keystore で暗号化したパスワード・各種設定) は、Google ドライブのバックアップにも、端末から端末への移行にも含めない。
     (Keystore の鍵は元々端末の外へ出ないので、暗号文だけが移っても復号できない。接続の設定にもホスト名・ユーザー名が入るので、まとめて対象外にする。) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
