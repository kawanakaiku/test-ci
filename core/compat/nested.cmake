# ネスト (ループバック) マウントのホストテスト。docs/nested-mount.md
# core/compat/CMakeLists.txt から include される (各 FS ライブラリが定義された後)。
if(USBMEM_BUILD_TESTS AND TARGET usbmem_ntfs AND TARGET usbmem_exfat AND TARGET usbmem_ext2 AND TARGET usbmem_ext4 AND TARGET usbmem_fat)
  add_executable(usbmem_nested_tests tests/test_nested.cpp)
  target_link_libraries(usbmem_nested_tests PRIVATE usbmem_ntfs usbmem_exfat usbmem_ext2 usbmem_ext4 usbmem_fat usbmem_compat_rt usbmem_core Threads::Threads)
  if(USBMEM_NTFS_WRITE)
    target_compile_definitions(usbmem_nested_tests PRIVATE USBMEM_NESTED_WRITE=1)
  endif()
  find_package(Python3 COMPONENTS Interpreter)
  if(Python3_FOUND AND EXISTS /dev/shm)
    set(NESTED_FIX_DIR /dev/shm/usbmem_nested_$ENV{USER})
    add_test(NAME nested_gen_fixture COMMAND ${CMAKE_COMMAND} -E env "PATH=$ENV{PATH}:/sbin:/usr/sbin" ${Python3_EXECUTABLE} -I ${CMAKE_CURRENT_LIST_DIR}/../../tools/gen_nested_fixture.py ${NESTED_FIX_DIR})
    set_tests_properties(nested_gen_fixture PROPERTIES FIXTURES_SETUP nested_fixture SKIP_RETURN_CODE 77 TIMEOUT 900)
    add_test(NAME nested_cycle COMMAND usbmem_nested_tests --cycle)
    foreach(_p ext4 ext2 fat exfat ntfs)
      if(_p STREQUAL ntfs)
        set(_prefix "/")
      else()
        set(_prefix "/imgs/")
      endif()
      foreach(_c read partitions depth lifetime readonly misc concurrent stale)
        add_test(NAME nested_${_c}_${_p} COMMAND usbmem_nested_tests --${_c} ${NESTED_FIX_DIR}/p_${_p}.img ${_prefix} ${NESTED_FIX_DIR})
        set_tests_properties(nested_${_c}_${_p} PROPERTIES FIXTURES_REQUIRED nested_fixture TIMEOUT 900
          ENVIRONMENT "ASAN_OPTIONS=verify_asan_link_order=0:detect_leaks=1")
      endforeach()
      # 読み出しエラー注入: 失敗したマウントの後始末は inode 内部の確保物を解放しきれない (既知。他の FS の ioerr と同じ扱いで leak 検査をしない)
      set(_kids c_ext2.img)
      if(_p STREQUAL ext4)
        list(APPEND _kids c_ext4.img c_fat.img c_ntfs.img)
      endif()
      foreach(_k ${_kids})
        add_test(NAME nested_ioerr_${_p}_${_k} COMMAND usbmem_nested_tests --ioerr ${NESTED_FIX_DIR}/p_${_p}.img ${_prefix} ${NESTED_FIX_DIR} ${_k})
        set_tests_properties(nested_ioerr_${_p}_${_k} PROPERTIES FIXTURES_REQUIRED nested_fixture TIMEOUT 1800
          ENVIRONMENT "ASAN_OPTIONS=verify_asan_link_order=0:detect_leaks=0")
      endforeach()
    endforeach()
  endif()
endif()
