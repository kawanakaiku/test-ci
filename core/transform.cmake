# BlockTransform (BitLocker / LUKS の読み取り専用復号) と暗号プリミティブ。docs/crypto-volumes.md
# core/CMakeLists.txt の末尾から include される。usbmem_core にだけ依存する (Android 非依存・PC でテスト可能)。
add_library(usbmem_transform STATIC
  src/crypto_hash.cpp src/crypto_aes.cpp src/crypto_aes_hw.cpp src/crypto_sha_hw.cpp src/crypto_argon2.cpp
  src/transform.cpp src/transform_bitlocker.cpp src/transform_luks.cpp src/mini_json.cpp src/c_api_transform.cpp)
target_include_directories(usbmem_transform PUBLIC include)
# 暗号ボリュームの書き込み (docs/crypto-volumes.md「書き込み」)。既定は OFF (配布ビルドは読み取り専用のまま)。USBMEM_NTFS_WRITE=ON のビルド (FS の書き込み検証用) では
# 既定で ON になり、上に載る FS の書き込み試験を暗号層越しに流せる。ON でも、open 時に OpenOptions::writable (C API: USBMEM_TRANSFORM_WRITABLE) を明示しないと書き込み可にならない。
if(USBMEM_NTFS_WRITE)
  set(_crypt_write_default ON)
else()
  set(_crypt_write_default OFF)
endif()
option(USBMEM_CRYPT_WRITE "暗号ボリューム (LUKS / BitLocker) の書き込み経路を有効にする (実験的)" ${_crypt_write_default})
if(USBMEM_CRYPT_WRITE)
  target_compile_definitions(usbmem_transform PUBLIC USBMEM_CRYPT_WRITE=1)
endif()
target_link_libraries(usbmem_transform PUBLIC usbmem_core)
target_compile_options(usbmem_transform PRIVATE -Wall -Wextra -Wpedantic -Wconversion -Wno-sign-conversion)

if(USBMEM_BUILD_TESTS)
  add_executable(usbmem_transform_tests tests/test_main.cpp tests/test_crypto.cpp tests/test_transform.cpp)
  target_include_directories(usbmem_transform_tests PRIVATE tests src)
  target_link_libraries(usbmem_transform_tests PRIVATE usbmem_transform)
  add_test(NAME crypto_unit COMMAND usbmem_transform_tests)
  # 暗号ボリュームの書き込みの検証ツール (独立実装との突き合わせは tools/run_crypt_write_tests.sh。書き込み有効のビルドのみ意味を持つ)
  add_executable(usbmem_cryptwrite_tool tests/cryptwrite_tool.cpp)
  target_link_libraries(usbmem_cryptwrite_tool PRIVATE usbmem_transform)
  if(USBMEM_CRYPT_WRITE)
    # cryptsetup / python3 cryptography / libbde が無ければ SKIP (77)。実カーネルの dm-crypt との照合は USBMEM_KERNEL_DMCRYPT=1 (CI: crypt-write.yml)
    add_test(NAME crypt_write COMMAND bash ${CMAKE_CURRENT_LIST_DIR}/../tools/run_crypt_write_tests.sh $<TARGET_FILE:usbmem_cryptwrite_tool>)
    set_tests_properties(crypt_write PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 3600 ENVIRONMENT "USBMEM_CW_OPS=300;USBMEM_CW_SEEDS=1;USBMEM_CW_FUZZ=40")
    if(USBMEM_SANITIZE)  # ASan + UBSan の Debug は桁違いに遅い (ソフトウェア AES)。ファジング・失敗注入は crypt-write.yml の crypt san ジョブでも回す
      set_tests_properties(crypt_write PROPERTIES ENVIRONMENT "USBMEM_CW_OPS=60;USBMEM_CW_SEEDS=1;USBMEM_CW_FUZZ=10")
    endif()
  endif()
  # 復号ボリュームの読み取り速度のマイクロベンチ (遅延つき模擬デバイス。ctest には入れない。docs/crypto-volumes.md 6.4)
  add_executable(usbmem_transform_bench tests/bench_transform.cpp)
  target_link_libraries(usbmem_transform_bench PRIVATE usbmem_transform)
  if(TARGET usbmem_btrfs)
    target_link_libraries(usbmem_transform_bench PRIVATE usbmem_btrfs)
    target_compile_definitions(usbmem_transform_bench PRIVATE USBMEM_BENCH_BTRFS=1)
  endif()
endif()

# 復号 → 既存 FS 実装への結合検証ツール (LinuxCompat 版 FS が有効なビルドのみ)
if(USBMEM_BUILD_TESTS AND TARGET usbmem_ntfs)
  add_executable(usbmem_cryptovol_tests compat/tests/test_cryptovol.cpp)
  target_include_directories(usbmem_cryptovol_tests PRIVATE compat/tests)
  target_link_libraries(usbmem_cryptovol_tests PRIVATE usbmem_transform usbmem_ntfs)
  target_compile_definitions(usbmem_cryptovol_tests PRIVATE USBMEM_CV_NTFS=1)
  foreach(_fs ext2 ext4 fat)
    if(TARGET usbmem_${_fs})
      string(TOUPPER ${_fs} _FS)
      target_link_libraries(usbmem_cryptovol_tests PRIVATE usbmem_${_fs})
      target_compile_definitions(usbmem_cryptovol_tests PRIVATE USBMEM_CV_${_FS}=1)
    endif()
  endforeach()
endif()

# ディスク全体の構成 (パーティション表の中の暗号パーティション / ディスク全体が暗号ボリューム / その中にパーティション表)。docs/crypto-volumes.md 6.5
if(USBMEM_BUILD_TESTS AND TARGET usbmem_ntfs)
  add_executable(usbmem_cryptodisk_tests compat/tests/test_cryptodisk.cpp)
  target_include_directories(usbmem_cryptodisk_tests PRIVATE compat/tests)
  target_link_libraries(usbmem_cryptodisk_tests PRIVATE usbmem_transform usbmem_ntfs)
  target_compile_definitions(usbmem_cryptodisk_tests PRIVATE USBMEM_CV_NTFS=1)
  foreach(_fs ext2 ext4 fat)
    if(TARGET usbmem_${_fs})
      string(TOUPPER ${_fs} _FS)
      target_link_libraries(usbmem_cryptodisk_tests PRIVATE usbmem_${_fs})
      target_compile_definitions(usbmem_cryptodisk_tests PRIVATE USBMEM_CV_${_FS}=1)
    endif()
  endforeach()
  # フィクスチャ (tools/gen_cryptodisk_fixtures.py。cryptsetup / sgdisk / sfdisk / mkntfs / ntfs-3g (FUSE) / python3 の cryptography・numpy が要る。無ければ SKIP)
  if(EXISTS /dev/shm)
    set(CRYPTODISK_FIX /dev/shm/usbmem_cryptodisk_$ENV{USER})
  else()
    set(CRYPTODISK_FIX ${CMAKE_CURRENT_BINARY_DIR}/cryptodisk_fixtures)
  endif()
  set(_cd_run ${CMAKE_CURRENT_LIST_DIR}/../tools/run_cryptodisk_tests.sh)
  add_test(NAME cryptodisk_gen_fixture COMMAND sh ${_cd_run} $<TARGET_FILE:usbmem_cryptodisk_tests> gen ${CRYPTODISK_FIX})
  set_tests_properties(cryptodisk_gen_fixture PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 1800)
  # part = パーティション表 (GPT / MBR+拡張) の中の暗号パーティション、whole = ディスク全体が暗号、nested = 全体が暗号で中に GPT、errors = 異常系 (パスワード違い・切り詰め・ヘッダ破損)
  foreach(_g part whole nested errors)
    add_test(NAME cryptodisk_${_g} COMMAND sh ${_cd_run} $<TARGET_FILE:usbmem_cryptodisk_tests> ${_g} ${CRYPTODISK_FIX})
    set_tests_properties(cryptodisk_${_g} PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 3600 DEPENDS cryptodisk_gen_fixture)
  endforeach()
  # 4 GiB を超えるオフセット (nbdfuse の疎ディスク)
  add_test(NAME cryptodisk_high_offset COMMAND sh ${CMAKE_CURRENT_LIST_DIR}/../tools/run_cryptodisk_highoffset_test.sh $<TARGET_FILE:usbmem_cryptodisk_tests>)
  set_tests_properties(cryptodisk_high_offset PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 1800)
endif()

# 実フィクスチャ (tools/gen_luks_fixtures.py / tools/winvhd/make_bitlocker_matrix.sh が /dev/shm/usbmem_crypt_$USER に作る) があれば検証。無ければ SKIP。
if(USBMEM_BUILD_TESTS AND TARGET usbmem_cryptovol_tests)
  add_test(NAME crypto_volume_fixtures COMMAND sh ${CMAKE_CURRENT_LIST_DIR}/../tools/run_crypto_volume_tests.sh $<TARGET_FILE:usbmem_cryptovol_tests>)
  set_tests_properties(crypto_volume_fixtures PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 3600)
  if(USBMEM_SANITIZE)
    set_tests_properties(crypto_volume_fixtures PROPERTIES ENVIRONMENT "USBMEM_CV_QUICK=1")
  endif()
endif()

# 暗号ボリューム (書き込み可) の上で書き込み可の FS (ext4 / ext2 / NTFS / FAT) を動かす検証 (tools/run_crypt_fs_tests.sh が独立実装で突き合わせる)
if(USBMEM_BUILD_TESTS AND USBMEM_CRYPT_WRITE AND USBMEM_NTFS_WRITE AND TARGET usbmem_cryptovol_tests)
  add_executable(usbmem_cryptfs_write_tests compat/tests/test_cryptfs_write.cpp)
  target_include_directories(usbmem_cryptfs_write_tests PRIVATE compat/tests)
  target_link_libraries(usbmem_cryptfs_write_tests PRIVATE usbmem_transform)
  foreach(_fs ntfs ext2 ext4 fat)
    if(TARGET usbmem_${_fs})
      string(TOUPPER ${_fs} _FS)
      target_link_libraries(usbmem_cryptfs_write_tests PRIVATE usbmem_${_fs})
      target_compile_definitions(usbmem_cryptfs_write_tests PRIVATE USBMEM_CFW_${_FS}=1)
    endif()
  endforeach()
  add_test(NAME crypt_fs_write COMMAND bash ${CMAKE_CURRENT_LIST_DIR}/../tools/run_crypt_fs_tests.sh $<TARGET_FILE:usbmem_cryptfs_write_tests>)
  set_tests_properties(crypt_fs_write PROPERTIES SKIP_RETURN_CODE 77 TIMEOUT 3600)
  if(USBMEM_SANITIZE)
    set_tests_properties(crypt_fs_write PROPERTIES ENVIRONMENT "USBMEM_CFS_OPS=40;USBMEM_CFS_FS=ext4 ntfs")
  endif()
endif()
