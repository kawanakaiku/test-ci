#!/bin/bash
# mount(8) のヘルパー (mount -t fuse.usbmem DEV MNT -o opts)。xfstests の FSTYP=fuse / FUSE_SUBTYP=.usbmem から呼ばれる。docs/xfstests.md
#   /sbin/mount.fuse.usbmem として置く。環境は /etc/usbmem_fuse.env (あれば) を読む (USBMEM_FUSE_BIN / USBMEM_FUSE_FSCK / USBMEM_FUSE_FSCK_LOG / USBMEM_FUSE_LOG / USBMEM_FUSE_TRACE)。
[ -f "${USBMEM_FUSE_ENV:-/etc/usbmem_fuse.env}" ] && . "${USBMEM_FUSE_ENV:-/etc/usbmem_fuse.env}"
BIN=${USBMEM_FUSE_BIN:-/usr/local/bin/usbmem_fuse}
dev=$1; mnt=$2; shift 2
opts=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) opts="${opts:+$opts,}$2"; shift 2 ;;
    -o*) opts="${opts:+$opts,}${1#-o}"; shift ;;
    -t|-N) shift 2 ;;
    *) shift ;;
  esac
done
# `mount -t fuse DEV MNT` (サブタイプなし。一部の fstests が FSTYP をそのまま mount に渡す: generic/338 441 484 409 ... ) は、このスクリプトを /sbin/mount.fuse としても置いた (run_xfstests.py) もので受ける。
# オプションに fstype= が無ければ既定 (USBMEM_FUSE_DEFAULT_OPTS = マウントの既定のオプション) を足す。すでにマウント中のデバイスをもう一度マウントするテスト (generic/409 など) は、
# デーモンの排他ロックを 120 秒待たず、すぐ失敗させる (直前のアンマウントの後始末を待つ場合は、マウント中ではないので従来どおり待つ)。
if [ "${0##*/}" = mount.fuse ]; then
  case ",$opts," in *,fstype=*) ;; *) opts="${USBMEM_FUSE_DEFAULT_OPTS}${opts:+,$opts}" ;; esac
  if awk -v d="$dev" '{ for (i = 1; i < NF; i++) if ($i == "-") { if ($(i + 2) == d) f = 1; break } } END { exit !f }' /proc/self/mountinfo; then
    echo "mount.fuse.usbmem: $dev is already mounted (one usbmem_fuse per image)" >&2
    exit 32
  fi
fi
# remount (xfstests の _scratch_remount ro / rw): デーモンは同じイメージを二重に開けないので、新しく起動せず、カーネル側の ro / rw だけを切り替える (mount -i = ヘルパーを呼ばない)。
# デーモンは書き込み可のままだが、ro の間はカーネルが書き込みを止める。FUSE にデーモン側の再マウントの手段は無い (docs/xfstests.md)。
case ",$opts," in
  *,remount,*)
    ro=rw; case ",$opts," in *,ro,*) ro=ro ;; esac
    exec mount -i -o "remount,$ro" "$mnt" ;;
esac
export USBMEM_FUSE_FSCK USBMEM_FUSE_FSCK_LOG USBMEM_FUSE_LOG USBMEM_FUSE_TRACE
exec "$BIN" ${opts:+-o "$opts"} "$dev" "$mnt"
